# ChemLove Environment Variables Configuration Template
# Copy this file to .env and configure your local settings.

# Flask settings
FLASK_SECRET_KEY=change-this-secret-key-to-something-secure
FLASK_ENV=development

# MySQL primary configuration (preferred way is using DATABASE_URL)
DATABASE_URL=mysql://root:password@localhost:3306/chemlove

# Alternatively, configure connection parameters individually
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=password
# MYSQL_DATABASE=chemlove

# ChemLove Admin/Teacher Configuration
TEACHER_ACCESS_CODE=CHEM2K26V3

# OAuth Configuration (for production/testing Google login)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
